<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .donation-container {
            max-width: 500px;
            margin: 2rem auto;
            padding: 2.5rem;
            background: var(--surface-color);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
        }
        .donation-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            border-radius: var(--border-radius) var(--border-radius) 0 0;
        }
        .foundation-preview {
            background: var(--background-color);
            padding: 1.5rem;
            border-radius: var(--border-radius);
            margin-bottom: 2rem;
            text-align: center;
        }
        .foundation-icon {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }
        .tokens-balance {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 1rem;
            border-radius: var(--border-radius);
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .form-actions {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }
        .btn-cancel {
            background: var(--text-secondary);
        }
        .btn-cancel:hover {
            background: #5a6268;
        }
    </style>
</head>
<body>
    <header class="header">
        <h1>🐾 Huellitas Felices</h1>
        <p>Realizar Donación</p>
    </header>

    <nav class="nav">
        <ul>
            <li><a href="/">🏠 Inicio</a></li>
            <li><a href="/mascotas">🐕 Mascotas</a></li>
            <li><a href="/donaciones">💝 Donaciones</a></li>
            <li><a href="/profile">👤 Mi Perfil</a></li>
            <li><a href="/logout">🚪 Cerrar Sesión</a></li>
        </ul>
    </nav>

    <div class="container">
        <div class="donation-container">
            <!-- Información de la fundación -->
            <div class="foundation-preview">
                <div class="foundation-icon"><%= foundation.image %></div>
                <h3><%= foundation.name %></h3>
                <p style="color: var(--text-secondary); margin-top: 0.5rem;"><%= foundation.description %></p>
            </div>

            <!-- Balance de tokens -->
            <div class="tokens-balance">
                <strong>Tu saldo: <%= user.tokens %> tokens</strong>
            </div>

            <% if (error) { %>
                <div class="error" style="margin-bottom: 2rem;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/donaciones/procesar" method="POST">
                <input type="hidden" name="foundationId" value="<%= foundation.id %>">
                
                <div class="form-group">
                    <label for="type">Tipo de ayuda *</label>
                    <select id="type" name="type" required>
                        <option value="">Seleccionar tipo de ayuda...</option>
                        <option value="comida">🍖 Comida para mascotas</option>
                        <option value="juguetes">🎾 Juguetes y entretenimiento</option>
                        <option value="medicinas">💊 Medicinas y cuidados médicos</option>
                        <option value="cuidados">🏥 Cuidados generales</option>
                        <option value="otro">❤️ Otro tipo de ayuda</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="amount">Cantidad de tokens a donar *</label>
                    <input type="number" id="amount" name="amount" min="1" max="<%= user.tokens %>" 
                           required placeholder="Ej: 50" value="10">
                    <small style="color: var(--text-secondary);">Mínimo: 1 token | Máximo: <%= user.tokens %> tokens</small>
                </div>

                <div class="form-group">
                    <label for="description">Mensaje opcional</label>
                    <textarea id="description" name="description" rows="3" 
                              placeholder="Puedes agregar un mensaje de apoyo o especificar tu donación..."></textarea>
                </div>

                <div class="form-actions">
                    <a href="/donaciones" class="btn btn-cancel">Cancelar</a>
                    <button type="submit" class="btn">Confirmar Donación</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>