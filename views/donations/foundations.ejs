<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .donations-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .tokens-display {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 1.5rem;
            border-radius: var(--border-radius);
            text-align: center;
            margin-bottom: 2rem;
            box-shadow: var(--shadow);
        }
        .tokens-amount {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }
        .foundations-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }
        .foundation-card {
            background: var(--surface-color);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            transition: var(--transition);
        }
        .foundation-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
        }
        .foundation-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 1.5rem;
            text-align: center;
        }
        .foundation-icon {
            font-size: 3rem;
            margin-bottom: 0.5rem;
        }
        .foundation-name {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }
        .foundation-body {
            padding: 1.5rem;
        }
        .foundation-description {
            color: var(--text-secondary);
            margin-bottom: 1.5rem;
            line-height: 1.5;
        }
        .needs-list {
            margin-bottom: 1.5rem;
        }
        .needs-title {
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }
        .needs-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .need-tag {
            background: var(--background-color);
            color: var(--text-primary);
            padding: 0.25rem 0.75rem;
            border-radius: 15px;
            font-size: 0.8rem;
            border: 1px solid var(--border-color);
        }
        .donation-actions {
            display: flex;
            gap: 0.5rem;
        }
        .btn-outline {
            background: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        .btn-outline:hover {
            background: var(--primary-color);
            color: white;
        }
        .history-link {
            text-align: center;
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border-color);
        }
    </style>
</head>
<body>
    <header class="header">
        <h1>🐾 Huellitas Felices</h1>
        <p>Haz la diferencia con tus donaciones</p>
    </header>

    <nav class="nav">
        <ul>
            <li><a href="/">🏠 Inicio</a></li>
            <li><a href="/mascotas">🐕 Mascotas</a></li>
            <li><a href="/donaciones" style="border-bottom-color: var(--primary-color);">💝 Donaciones</a></li>
            <li><a href="/mapa">🗺️ Mapa</a></li>
            <li><a href="/profile">👤 Mi Perfil</a></li>
            <li><a href="/logout">🚪 Cerrar Sesión</a></li>
        </ul>
    </nav>

    <div class="container">
        <div class="donations-header">
            <h2>💝 Fundaciones que Necesitan tu Ayuda</h2>
        </div>

        <!-- Display de tokens -->
        <div class="tokens-display">
            <div class="tokens-amount"><%= user.tokens %> tokens</div>
            <p>Disponibles para donaciones</p>
            <a href="/profile" class="btn" style="background: white; color: var(--primary-color); margin-top: 1rem;">
                Recargar Tokens
            </a>
        </div>

        <% if (success) { %>
            <div class="success" style="margin-bottom: 2rem;">
                <%= success %>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="error" style="margin-bottom: 2rem;">
                <%= error %>
            </div>
        <% } %>

        <!-- Grid de fundaciones -->
        <div class="foundations-grid">
            <% foundations.forEach(foundation => { %>
                <div class="foundation-card">
                    <div class="foundation-header">
                        <div class="foundation-icon"><%= foundation.image %></div>
                        <div class="foundation-name"><%= foundation.name %></div>
                    </div>
                    <div class="foundation-body">
                        <div class="foundation-description">
                            <%= foundation.description %>
                        </div>
                        
                        <div class="needs-list">
                            <div class="needs-title">Necesitan ayuda con:</div>
                            <div class="needs-tags">
                                <% foundation.needs.forEach(need => { %>
                                    <span class="need-tag">
                                        <%= need === 'comida' ? '🍖 Comida' : '' %>
                                        <%= need === 'juguetes' ? '🎾 Juguetes' : '' %>
                                        <%= need === 'medicinas' ? '💊 Medicinas' : '' %>
                                        <%= need === 'cuidados' ? '🏥 Cuidados' : '' %>
                                    </span>
                                <% }); %>
                            </div>
                        </div>

                        <div class="donation-actions">
                            <a href="/donaciones/donar/<%= foundation.id %>" class="btn btn-block">Donar Ahora</a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>

        <div class="history-link">
            <a href="/donaciones/historial" class="btn btn-outline">📊 Ver mi historial de donaciones</a>
        </div>
    </div>
</body>
</html>