<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .pet-details-container {
            max-width: 1000px;
            margin: 2rem auto;
        }
        .pet-details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            margin-bottom: 2rem;
        }
        @media (max-width: 768px) {
            .pet-details-grid {
                grid-template-columns: 1fr;
            }
        }
        .pet-image-large {
            width: 100%;
            height: 400px;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 6rem;
            box-shadow: var(--shadow);
        }
        .pet-info-card {
            background: var(--surface-color);
            padding: 2rem;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
        }
        .pet-name-large {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 1rem;
        }
        .pet-badges {
            margin-bottom: 1.5rem;
        }
        .pet-badge-large {
            display: inline-block;
            padding: 0.5rem 1rem;
            background: var(--primary-color);
            color: white;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }
        .pet-description-large {
            font-size: 1.1rem;
            line-height: 1.6;
            color: var(--text-primary);
            margin-bottom: 2rem;
        }
        .contact-info {
            background: var(--background-color);
            padding: 1.5rem;
            border-radius: var(--border-radius);
            margin-top: 2rem;
        }
        .contact-info h3 {
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
        .contact-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        .contact-item {
            display: flex;
            flex-direction: column;
        }
        .contact-label {
            font-weight: 600;
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 0.25rem;
        }
        .contact-value {
            font-size: 1rem;
            color: var(--text-primary);
        }
        .actions-section {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }
    </style>
</head>
<body>
    <header class="header">
        <h1>🐾 Huellitas Felices</h1>
        <p>Conoce a <%= pet.name %></p>
    </header>

    <nav class="nav">
        <ul>
            <li><a href="/">🏠 Inicio</a></li>
            <li><a href="/mascotas">🐕 Mascotas</a></li>
            <% if (user) { %>
                <li><a href="/profile">👤 Mi Perfil</a></li>
                <li><a href="/logout">🚪 Cerrar Sesión</a></li>
            <% } else { %>
                <li><a href="/login">🔐 Iniciar Sesión</a></li>
            <% } %>
        </ul>
    </nav>

    <div class="container">
        <div class="pet-details-container">
            <div class="pet-details-grid">
                <!-- Imagen de la mascota -->
                <div class="pet-image-large" style="<%= pet.image && pet.image !== '/images/pets/default-pet.jpg' ? 'background: none;' : '' %>">
                    <% if (pet.image && pet.image !== '/images/pets/default-pet.jpg') { %>
                        <img src="<%= pet.image %>" alt="<%= pet.name %>" style="width: 100%; height: 100%; object-fit: cover; border-radius: var(--border-radius);">
                    <% } else { %>
                        <%= pet.type === 'perro' ? '🐕' : '🐱' %>
                    <% } %>
            </div>

                <!-- Información de la mascota -->
                <div class="pet-info-card">
                    <h1 class="pet-name-large"><%= pet.name %></h1>
                    
                    <div class="pet-badges">
                        <span class="pet-badge-large" style="background: <%= pet.type === 'perro' ? '#4A90E2' : '#FF6B6B' %>;">
                            <%= pet.type === 'perro' ? '🐕 Perro' : '🐱 Gato' %>
                        </span>
                        <span class="pet-badge-large" style="background: var(--secondary-color);">
                            📏 <%= pet.size %>
                        </span>
                        <span class="pet-badge-large" style="background: var(--accent-color);">
                            <%= pet.gender === 'macho' ? '♂ Macho' : '♀ Hembra' %>
                        </span>
                        <span class="pet-badge-large" style="background: var(--success-color);">
                            🎂 <%= pet.age %> años
                        </span>
                    </div>

                    <div class="pet-description-large">
                        <p><%= pet.description %></p>
                    </div>

                    <div class="pet-details">
                        <div style="margin-bottom: 1rem;">
                            <strong>🏷️ Raza:</strong> <%= pet.breed %>
                        </div>
                        <div style="margin-bottom: 1rem;">
                            <strong>📍 Ubicación:</strong> <%= pet.location %>
                        </div>
                        <div style="margin-bottom: 1rem;">
                            <strong>📅 Publicado:</strong> <%= new Date(pet.createdAt).toLocaleDateString('es-ES') %>
                        </div>
                        <div>
                            <strong>📊 Estado:</strong> 
                            <span style="color: <%= pet.status === 'disponible' ? 'var(--success-color)' : 'var(--accent-color)' %>; font-weight: 600;">
                                <%= pet.status === 'disponible' ? '✅ Disponible para adopción' : '🏠 Adoptado' %>
                            </span>
                        </div>
                    </div>

                    <!-- Información de contacto -->
                    <div class="contact-info">
                        <h3>📞 Información de Contacto</h3>
                        <div class="contact-details">
                            <div class="contact-item">
                                <span class="contact-label">👤 Publicado por:</span>
                                <span class="contact-value"><%= pet.owner.name %></span>
                            </div>
                            <div class="contact-item">
                                <span class="contact-label">📧 Email:</span>
                                <span class="contact-value"><%= pet.owner.email %></span>
                            </div>
                            <div class="contact-item">
                                <span class="contact-label">📞 Teléfono:</span>
                                <span class="contact-value"><%= pet.phoneContact %></span>
                            </div>
                            <div class="contact-item">
                                <span class="contact-label">📍 Ubicación:</span>
                                <span class="contact-value"><%= pet.location %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Acciones -->
                    <div class="actions-section">
                        <a href="/mascotas" class="btn btn-outline">← Volver a Mascotas</a>
                        <% if (user && user.id === pet.owner._id.toString()) { %>
                            <form action="/mascotas/<%= pet._id %>/adoptado" method="POST" style="display: inline;">
                                <button type="submit" class="btn" style="background: var(--success-color);">
                                    ✅ Marcar como Adoptado
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>